      in1ptr++;
      in2ptr++;
      outptr++;
      size--;
    }
  while (size >= sizeof (grub_uint64_t))
    {

      *(grub_uint64_t *) (void *) outptr
 = (*(const grub_uint64_t *) (const void *) in1ptr
    ^ *(const grub_uint64_t *) (const void *) in2ptr);
