      void *hook_arg)
{
  char *sua;
  struct grub_iso9660_susp_entry *entry;
  grub_err_t err;
  int ce_counter = 0;
  grub_ssize_t ce_sua_size = 0;
  grub_off_t ce_off;
  grub_disk_addr_t ce_block;

