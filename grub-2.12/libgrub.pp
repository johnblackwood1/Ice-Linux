      if (grub_strncmp ((char *) entry->sig, "CE", 2) == 0)
 {
   struct grub_iso9660_susp_ce *ce;

   if (ce_sua_size > 0)
     {
       grub_free (sua);
       return grub_error (GRUB_ERR_BAD_FS,
     "more than one CE entry in SUSP area");
     }


