      desc = &block.sun_block.partitions[partnum];
      p->start = ((grub_uint32_t) (desc->start_sector));
      p->len = ((grub_uint32_t) (desc->num_sectors));
      p->number = partnum;
      if (p->len)
 {
   if (hook (disk, p, hook_data))
     partnum = 16;
 }
    }

