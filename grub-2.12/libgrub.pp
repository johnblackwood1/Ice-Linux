  .name = "newc",
  .fs_dir = grub_cpio_dir,
  .fs_open = grub_cpio_open,
  .fs_read = grub_cpio_read,
  .fs_close = grub_cpio_close,

  .reserved_first_sector = 0,
  .blocklist_install = 0,

