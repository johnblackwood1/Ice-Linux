static inline void
print_tabs (int n)
{
  int i;

  for (i = 0; i < n; i++)
    grub_printf (" ");
}

static grub_err_t
print_state (char *nvlist, int tab)
{
  grub_uint64_t ival;
  int isok = 1;

  print_tabs (tab);

  if (grub_zfs_nvlist_lookup_uint64 (nvlist, "removed", &ival))
    {
      grub_puts_ ("Virtual device is removed");
      isok = 0;
    }

  if (grub_zfs_nvlist_lookup_uint64 (nvlist, "faulted", &ival))
    {
      grub_puts_ ("Virtual device is faulted");
      isok = 0;
    }

  if (grub_zfs_nvlist_lookup_uint64 (nvlist, "offline", &ival))
    {
      grub_puts_ ("Virtual device is offline");
      isok = 0;
    }

  if (grub_zfs_nvlist_lookup_uint64 (nvlist, "faulted", &ival))


    grub_puts_ ("Virtual device is degraded");

  if (isok)
    grub_puts_ ("Virtual device is online");
  grub_xputs ("\n");

  return GRUB_ERR_NONE;
}

static grub_err_t
print_vdev_info (char *nvlist, int tab)
{
  char *type = 0;

  type = grub_zfs_nvlist_lookup_string (nvlist, "type");

  if (!type)
    {
      print_tabs (tab);
      grub_puts_ ("Incorrect virtual device: no type available");
      return grub_errno;
    }

  if (grub_strcmp (type, "disk") == 0)
    {
      char *bootpath = 0;
      char *path = 0;
      char *devid = 0;

      print_tabs (tab);





      grub_puts_ ("Leaf virtual device (file or disk)");

      print_state (nvlist, tab);

      bootpath =
 grub_zfs_nvlist_lookup_string (nvlist, "phys_path");
      print_tabs (tab);
      if (!bootpath)
 grub_puts_ ("Bootpath: unavailable\n");
      else
 grub_printf_ ("Bootpath: %s\n", bootpath);

      path = grub_zfs_nvlist_lookup_string (nvlist, "path");
      print_tabs (tab);
      if (!path)
 grub_puts_ ("Path: unavailable");
      else
 grub_printf_ ("Path: %s\n", path);

      devid = grub_zfs_nvlist_lookup_string (nvlist, "devid");
      print_tabs (tab);
      if (!devid)
 grub_puts_ ("Devid: unavailable");
      else
 grub_printf_ ("Devid: %s\n", devid);
      grub_free (bootpath);
      grub_free (devid);
      grub_free (path);
      grub_free (type);
      return GRUB_ERR_NONE;
    }
  char is_mirror=(grub_strcmp(type,"mirror") == 0);
  char is_raidz=(grub_strcmp(type,"raidz") == 0);
  grub_free (type);

  if (is_mirror || is_raidz)
    {
      int nelm, i;

      nelm = grub_zfs_nvlist_lookup_nvlist_array_get_nelm
 (nvlist, "children");

      if(is_mirror){
  grub_puts_ ("This VDEV is a mirror");
      }
      else if(is_raidz){
  grub_uint64_t parity;
  grub_zfs_nvlist_lookup_uint64(nvlist,"nparity",&parity);
  grub_printf_ ("This VDEV is a RAIDZ%llu\n",(unsigned long long)parity);
      }
      print_tabs (tab);
      if (nelm <= 0)
 {
   grub_puts_ ("Incorrect VDEV");
   return GRUB_ERR_NONE;
 }
      grub_printf_ ("VDEV with %d children\n", nelm);
      print_state (nvlist, tab);
      for (i = 0; i < nelm; i++)
 {
   char *child;

   child = grub_zfs_nvlist_lookup_nvlist_array
     (nvlist, "children", i);

   print_tabs (tab);
   if (!child)
     {




       grub_printf_ ("VDEV element number %d isn't correct\n", i);
       continue;
     }




   grub_printf_ ("VDEV element number %d:\n", i);
   print_vdev_info (child, tab + 1);

   grub_free (child);
 }
      return GRUB_ERR_NONE;
    }

  print_tabs (tab);
  grub_printf_ ("Unknown virtual device type: %s\n", type);

  return GRUB_ERR_NONE;
}

static grub_err_t
get_bootpath (char *nvlist, char **bootpath, char **devid)
{
  char *type = 0;

  type = grub_zfs_nvlist_lookup_string (nvlist, "type");

  if (!type)
    return grub_errno;

  if (grub_strcmp (type, "disk") == 0)
    {
      *bootpath = grub_zfs_nvlist_lookup_string (nvlist,
       "phys_path");
      *devid = grub_zfs_nvlist_lookup_string (nvlist, "devid");
      if (!*bootpath || !*devid)
 {
   grub_free (*bootpath);
   grub_free (*devid);
   *bootpath = 0;
   *devid = 0;
 }
      return GRUB_ERR_NONE;
    }

  if (grub_strcmp (type, "mirror") == 0)
    {
      int nelm, i;

      nelm = grub_zfs_nvlist_lookup_nvlist_array_get_nelm
 (nvlist, "children");

      for (i = 0; i < nelm; i++)
 {
   char *child;

   child = grub_zfs_nvlist_lookup_nvlist_array (nvlist,
             "children",
             i);

   get_bootpath (child, bootpath, devid);

   grub_free (child);

   if (*bootpath && *devid)
     return GRUB_ERR_NONE;
 }
    }

  return GRUB_ERR_NONE;
}

static const char *poolstates[] = {



  [POOL_STATE_ACTIVE] = "Pool state: active",
  [POOL_STATE_EXPORTED] = "Pool state: exported",
  [POOL_STATE_DESTROYED] = "Pool state: destroyed",
  [POOL_STATE_SPARE] = "Pool state: reserved for hot spare",
  [POOL_STATE_L2CACHE] = "Pool state: level 2 ARC device",
  [POOL_STATE_UNINITIALIZED] = "Pool state: uninitialized",
  [POOL_STATE_UNAVAIL] = "Pool state: unavailable",
  [POOL_STATE_POTENTIALLY_ACTIVE] = "Pool state: potentially active"
};

static grub_err_t
grub_cmd_zfsinfo (grub_command_t cmd __attribute__ ((unused)), int argc,
    char **args)
{
  grub_device_t dev;
  char *devname;
  grub_err_t err;
  char *nvlist = 0;
  char *nv = 0;
  char *poolname;
  grub_uint64_t guid;
  grub_uint64_t pool_state;
  int found;

  if (argc < 1)
    return grub_error (GRUB_ERR_BAD_ARGUMENT, "one argument expected");

  if (args[0][0] == '(' && args[0][grub_strlen (args[0]) - 1] == ')')
    {
      devname = grub_strdup (args[0] + 1);
      if (devname)
 devname[grub_strlen (devname) - 1] = 0;
    }
  else
    devname = grub_strdup (args[0]);
  if (!devname)
    return grub_errno;

  dev = grub_device_open (devname);
  grub_free (devname);
  if (!dev)
    return grub_errno;

  err = grub_zfs_fetch_nvlist (dev, &nvlist);

  grub_device_close (dev);

  if (err)
    return err;

  poolname = grub_zfs_nvlist_lookup_string (nvlist, "name");
  if (!poolname)
    grub_puts_ ("Pool name: unavailable");
  else
    grub_printf_ ("Pool name: %s\n", poolname);

  found =
    grub_zfs_nvlist_lookup_uint64 (nvlist, "pool_guid", &guid);
  if (!found)
    grub_puts_ ("Pool GUID: unavailable");
  else
    grub_printf_ ("Pool GUID: %016llx\n", (long long unsigned) guid);

  found = grub_zfs_nvlist_lookup_uint64 (nvlist, "state",
      &pool_state);
  if (!found)
    grub_puts_ ("Unable to retrieve pool state");
  else if (pool_state >= (sizeof (poolstates) / sizeof (poolstates[0])))
    grub_puts_ ("Unrecognized pool state");
  else
    grub_puts_ (poolstates[pool_state]);

  nv = grub_zfs_nvlist_lookup_nvlist (nvlist, "vdev_tree");

  if (!nv)



    grub_puts_ ("No virtual device tree available");
  else
    print_vdev_info (nv, 1);

  grub_free (nv);
  grub_free (nvlist);

  return GRUB_ERR_NONE;
}

static grub_err_t
grub_cmd_zfs_bootfs (grub_command_t cmd __attribute__ ((unused)), int argc,
       char **args)
{
  grub_device_t dev;
  char *devname;
  grub_err_t err;
  char *nvlist = 0;
  char *nv = 0;
  char *bootpath = 0, *devid = 0;
  char *fsname;
  char *bootfs;
  char *poolname;
  grub_uint64_t mdnobj;

  if (argc < 1)
    return grub_error (GRUB_ERR_BAD_ARGUMENT, "one argument expected");

  devname = grub_file_get_device_name (args[0]);
  if (grub_errno)
    return grub_errno;

  dev = grub_device_open (devname);
  grub_free (devname);
  if (!dev)
    return grub_errno;

  err = grub_zfs_fetch_nvlist (dev, &nvlist);

  fsname = grub_strchr (args[0], ')');
  if (fsname)
    fsname++;
  else
    fsname = args[0];

  if (!err)
    err = grub_zfs_getmdnobj (dev, fsname, &mdnobj);

  grub_device_close (dev);

  if (err)
    return err;

  poolname = grub_zfs_nvlist_lookup_string (nvlist, "name");
  if (!poolname)
    {
      if (!grub_errno)
 grub_error (GRUB_ERR_BAD_FS, "No poolname found");
      return grub_errno;
    }

  nv = grub_zfs_nvlist_lookup_nvlist (nvlist, "vdev_tree");

  if (nv)
    get_bootpath (nv, &bootpath, &devid);

  grub_free (nv);
  grub_free (nvlist);

  bootfs = grub_xasprintf ("zfs-bootfs=%s/%llu%s%s%s%s%s%s",
      poolname, (unsigned long long) mdnobj,
      bootpath ? ",bootpath=\"" : "",
      bootpath ? : "",
      bootpath ? "\"" : "",
      devid ? ",diskdevid=\"" : "",
      devid ? : "",
      devid ? "\"" : "");
  if (!bootfs)
    return grub_errno;
  if (argc >= 2)
    grub_env_set (args[1], bootfs);
  else
    grub_printf ("%s\n", bootfs);

  grub_free (bootfs);
  grub_free (poolname);
  grub_free (bootpath);
  grub_free (devid);

  return GRUB_ERR_NONE;
}


static grub_command_t cmd_info, cmd_bootfs;

@MARKER@zfsinfo@
{
  cmd_info = grub_register_command ("zfsinfo", grub_cmd_zfsinfo,
        "DEVICE",
        "Print ZFS info about DEVICE.");
  cmd_bootfs = grub_register_command ("zfs-bootfs", grub_cmd_zfs_bootfs,
          "FILESYSTEM [VARIABLE]",
          "Print ZFS-BOOTFSOBJ or store it into VARIABLE");
}

GRUB_MOD_FINI (zfsinfo)
{
  grub_unregister_command (cmd_info);
  grub_unregister_command (cmd_bootfs);
}
