}




static inline grub_uint8_t *
grub_latin1_to_utf8 (grub_uint8_t *dest, const grub_uint8_t *src,
       grub_size_t size)
{
  while (size--)
    {
      if (!(*src & 0x80))
 *dest++ = *src;
      else
 {
   *dest++ = (*src >> 6) | 0xC0;
   *dest++ = (*src & 0x3F) | 0x80;
 }
      src++;
    }

  return dest;
}


