}





static grub_err_t
grub_hfs_iterate_dir (struct grub_hfs_data *data, grub_uint32_t root_idx,
        grub_uint32_t dir, int (*hook) (struct grub_hfs_record *, void *hook_arg),
        void *hook_arg)
