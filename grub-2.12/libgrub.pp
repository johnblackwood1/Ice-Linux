      err = grub_disk_read (node->data->disk,
       ((grub_disk_addr_t) ((grub_uint32_t) (node->dirents[i].first_sector))) << 2,
       off, toread, buf);
      if (err)
 return err;
      len -= toread;
      off += toread;
      buf += toread;
    }
  return GRUB_ERR_NONE;
}




static grub_err_t
grub_iso9660_susp_iterate (grub_fshelp_node_t node, grub_off_t off,
      grub_ssize_t sua_size,
