static void
rebuild_raid5 (char *dest, struct raid56_buffer *buffers,
        grub_uint64_t nstripes, grub_uint64_t csize)
{
  grub_uint64_t i;
  int first;

  for(i = 0; buffers[i].data_is_valid && i < nstripes; i++);

  if (i == nstripes)
    {
      grub_real_dprintf("config-util.h", 711, "btrfs", "called rebuild_raid5(), but all disks are OK\n");
      return;
    }

  grub_real_dprintf("config-util.h", 715, "btrfs", "rebuilding RAID 5 stripe #%" "lu" "\n", i);

  for (i = 0, first = 1; i < nstripes; i++)
    {
