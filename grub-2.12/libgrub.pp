      "[-h|-p|-r] [FILE]",
      "Import ZFS wrapping key stored in FILE.",
      options);
}

GRUB_MOD_FINI(zfscrypt)
{
  grub_zfs_decrypt = 0;
  grub_zfs_load_key = 0;
  grub_unregister_extcmd (cmd_key);
