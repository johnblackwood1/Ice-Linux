   grub_free (sua);
   return grub_error (GRUB_ERR_BAD_FS, "suspecting endless CE loop");
 }
      if (ce_sua_size < 4)
 {
   grub_free (sua);
   return grub_error (GRUB_ERR_BAD_FS, "invalid continuation area in CE entry");
 }

      grub_free (sua);
      sua = grub_malloc (ce_sua_size);
      if (!sua)
