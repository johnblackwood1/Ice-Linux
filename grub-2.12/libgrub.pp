static grub_disk_addr_t
grub_hfsplus_find_block (struct grub_hfsplus_extent *extent,
    grub_disk_addr_t *fileblock)
{
  int i;
  grub_disk_addr_t blksleft = *fileblock;


  for (i = 0; i < 8; i++)
    {
      if (blksleft < grub_swap_bytes32(extent[i].count))
