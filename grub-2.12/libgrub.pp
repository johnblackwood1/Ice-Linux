static inline grub_size_t
grub_utf8_to_utf16 (grub_uint16_t *dest, grub_size_t destsize,
      const grub_uint8_t *src, grub_size_t srcsize,
      const grub_uint8_t **srcend)
{
  grub_uint16_t *p = dest;
  int count = 0;
  grub_uint32_t code = 0;

  if (srcend)
    *srcend = src;

  while (srcsize && destsize)
    {
      int was_count = count;
      if (srcsize != (grub_size_t)-1)
 srcsize--;
      if (!grub_utf8_process (*src++, &code, &count))
 {
   code = '?';
   count = 0;

   if (was_count)
     src--;
 }
      if (count != 0)
 continue;
      if (code == 0)
 break;
      if (destsize < 2 && code >= 0x10000)
 break;
      if (code >= 0x10000)
 {
   *p++ = (0xD800 | ((((code) - 0x10000) >> 10) & 0x3ff));
   *p++ = (0xDC00 | (((code) - 0x10000) & 0x3ff));
   destsize -= 2;
 }
      else
 {
   *p++ = code;
   destsize--;
 }
    }

  if (srcend)
    *srcend = src;
  return p - dest;
}



static inline grub_size_t
grub_getend (const char *beg, const char *end)
{
  const char *ptr;
  for (ptr = end - 1; ptr >= beg; ptr--)
    if ((*ptr & 0xc0) != 0x80)
      break;
  if (ptr < beg)
    return 0;
  if ((*ptr & 0x80) == 0)
    return ptr + 1 - beg;
  if ((*ptr & 0xe0) == 0xc0
      && ptr + 2 <= end)
    return ptr + 2 - beg;
  if ((*ptr & 0xf0) == 0xe0
      && ptr + 3 <= end)
    return ptr + 3 - beg;
  if ((*ptr & 0xf8) == 0xf0
      && ptr + 4 <= end)
    return ptr + 4 - beg;

  return ptr - beg;
}


static inline grub_uint8_t *
grub_utf16_to_utf8 (grub_uint8_t *dest, const grub_uint16_t *src,
      grub_size_t size)
{
  grub_uint32_t code_high = 0;

  while (size--)
    {
      grub_uint32_t code = *src++;

      if (code_high)
 {
   if (code >= 0xDC00 && code <= 0xDFFF)
     {

       code = ((code_high - 0xD800) << 10) + (code - 0xDC00) + 0x10000;

       *dest++ = (code >> 18) | 0xF0;
       *dest++ = ((code >> 12) & 0x3F) | 0x80;
       *dest++ = ((code >> 6) & 0x3F) | 0x80;
       *dest++ = (code & 0x3F) | 0x80;
     }
   else
     {

       *dest++ = '?';

       src--;
     }

   code_high = 0;
 }
      else
 {
   if (code <= 0x007F)
     *dest++ = code;
   else if (code <= 0x07FF)
     {
       *dest++ = (code >> 6) | 0xC0;
       *dest++ = (code & 0x3F) | 0x80;
     }
   else if (code >= 0xD800 && code <= 0xDBFF)
     {
       code_high = code;
       continue;
     }
   else if (code >= 0xDC00 && code <= 0xDFFF)
     {

       *dest++ = '?';
     }
   else if (code < 0x10000)
     {
       *dest++ = (code >> 12) | 0xE0;
       *dest++ = ((code >> 6) & 0x3F) | 0x80;
       *dest++ = (code & 0x3F) | 0x80;
     }
   else
     {
       *dest++ = (code >> 18) | 0xF0;
       *dest++ = ((code >> 12) & 0x3F) | 0x80;
       *dest++ = ((code >> 6) & 0x3F) | 0x80;
       *dest++ = (code & 0x3F) | 0x80;
