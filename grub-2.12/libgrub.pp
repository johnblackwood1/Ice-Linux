static inline int
grub_utf8_process (grub_uint8_t c, grub_uint32_t *code, int *count)
{
  if (*count)
    {
      if ((c & 0xc0) != 0x80)
 {
   *count = 0;

   return 0;
 }
      else
 {
   *code <<= 6;
   *code |= (c & 0x3f);
   (*count)--;

   if ((*count == 1 && *code <= 0x1f)
       || (*count == 2 && *code <= 0xf))
     {
       *code = 0;
       *count = 0;
       return 0;
     }
   return 1;
 }
    }

  if ((c & 0x80) == 0)
    {
      *code = c;
      return 1;
    }
  if ((c & 0xe0) == 0xc0)
    {
      *count = 1;
      *code = c & 0x1f;

      if (*code <= 1)
 {
   *count = 0;
   *code = 0;
   return 0;
 }
      return 1;
    }
  if ((c & 0xf0) == 0xe0)
    {
      *count = 2;
      *code = c & 0x0f;
      return 1;
    }
  if ((c & 0xf8) == 0xf0)
    {
      *count = 3;
      *code = c & 0x07;
      return 1;
    }
  return 0;
}
