static inline void
grub_video_register (grub_video_adapter_t adapter)
{
  grub_video_adapter_t *p;
  for (p = &grub_video_adapter_list; *p && (*p)->prio > adapter->prio;
       p = &((*p)->next));
  adapter->next = *p;
  *p = adapter;

  adapter->prev = p;
  if (adapter->next)
    adapter->next->prev = &adapter->next;
}



static inline void
grub_video_unregister (grub_video_adapter_t adapter)
{
  grub_list_remove ((((char *) &(adapter)->next == (char *) &((grub_list_t) (adapter))->next) && ((char *) &(adapter)->prev == (char *) &((grub_list_t) (adapter))->prev) ? (grub_list_t) adapter : (grub_list_t) grub_bad_type_cast_real(431, "config-util.h")));
}



