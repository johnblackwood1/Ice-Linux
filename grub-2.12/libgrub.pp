static void
grub_video_fbfill (struct grub_video_fbblit_info *dst,
     grub_video_color_t color, int x, int y,
     unsigned int width, unsigned int height)
{
  unsigned int i, j;

  for (j = 0; j < height; j++)
    for (i = 0; i < width; i++)
      set_pixel (dst, x + i, y + j, color);
}



static void
grub_video_fbfill_direct32 (struct grub_video_fbblit_info *dst,
       grub_video_color_t color, int x, int y,
       unsigned int width, unsigned int height)
{
  unsigned int i, j;
  grub_uint32_t *dstptr;
  grub_size_t rowskip;



  if (__builtin_mul_overflow(dst->mode_info->bytes_per_pixel, width, &rowskip) ||
      __builtin_sub_overflow(dst->mode_info->pitch, rowskip, &rowskip))
    return;


  dstptr = grub_video_fb_get_video_ptr (dst, x, y);

  for (j = 0; j < height; j++)
    {
      for (i = 0; i < width; i++)
        *dstptr++ = color;


      ((dstptr) += (rowskip) / sizeof (*(dstptr)));
    }
}



static void
grub_video_fbfill_direct24 (struct grub_video_fbblit_info *dst,
       grub_video_color_t color, int x, int y,
       unsigned int width, unsigned int height)
{
  unsigned int i, j;
  grub_size_t rowskip;
  grub_uint8_t *dstptr;

  grub_uint8_t fill0 = (grub_uint8_t)((color >> 0) & 0xFF);
  grub_uint8_t fill1 = (grub_uint8_t)((color >> 8) & 0xFF);
  grub_uint8_t fill2 = (grub_uint8_t)((color >> 16) & 0xFF);







  if (__builtin_mul_overflow(dst->mode_info->bytes_per_pixel, width, &rowskip) ||
      __builtin_sub_overflow(dst->mode_info->pitch, rowskip, &rowskip))
    return;


  dstptr = grub_video_fb_get_video_ptr (dst, x, y);

  for (j = 0; j < height; j++)
    {
      for (i = 0; i < width; i++)
        {
          *dstptr++ = fill0;
          *dstptr++ = fill1;
          *dstptr++ = fill2;
        }


      dstptr += rowskip;
    }
}



static void
grub_video_fbfill_direct16 (struct grub_video_fbblit_info *dst,
       grub_video_color_t color, int x, int y,
       unsigned int width, unsigned int height)
{
  unsigned int i, j;
  grub_size_t rowskip;
  grub_uint16_t *dstptr;



  if (__builtin_mul_overflow(dst->mode_info->bytes_per_pixel, width, &rowskip) ||
