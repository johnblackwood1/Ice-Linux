static grub_err_t
plan_partition_map_iterate (grub_disk_t disk,
       grub_partition_iterate_hook_t hook,
       void *hook_data)
{
  struct grub_partition p;
  int ptr = 0;
  grub_err_t err;

  p.partmap = &grub_plan_partition_map;
  p.msdostype = 0;

  for (p.number = 0; ; p.number++)
    {
