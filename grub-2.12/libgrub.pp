static grub_uint32_t
amiga_partition_map_checksum (void *buf)
{
  grub_uint32_t *ptr = buf;
  grub_uint32_t r = 0;
  grub_size_t sz;

  if (ptr[1] & ~((((128 - 1) & 0xff) << 24) | (((128 - 1) & 0xff00) << 8) | (((128 - 1) & 0xff0000) >> 8) | (((128 - 1) & 0xff000000UL) >> 24)))
    sz = 128;
  else
    sz = grub_swap_bytes32(ptr[1]);

  for (; sz; sz--, ptr++)
    r += grub_swap_bytes32(*ptr);

  return r;
}

static grub_err_t
amiga_partition_map_iterate (grub_disk_t disk,
        grub_partition_iterate_hook_t hook,
        void *hook_data)
{
  struct grub_partition part;
  struct grub_amiga_rdsk rdsk;
  int partno = 0;
  int next = -1;
  unsigned pos;


  for (pos = 0; pos < 15; pos++)
    {

      if (grub_disk_read (disk, pos, 0, sizeof (rdsk), &rdsk))
 return grub_errno;

      if (grub_memcmp (rdsk.magic, "RDSK",
         sizeof (rdsk.magic)) == 0
   && amiga_partition_map_checksum (&rdsk) == 0)
 {

   next = grub_swap_bytes32(rdsk.partitionlst);
   break;
 }
    }

  if (next == -1)
    return grub_error (GRUB_ERR_BAD_PART_TABLE,
         "Amiga partition map not found");


  while (next != -1)
    {
      struct grub_amiga_partition apart;


      if (grub_disk_read (disk, next, 0, sizeof (apart), &apart))
 return grub_errno;

      if (grub_memcmp (apart.magic, "PART",
         sizeof (apart.magic)) != 0
   || amiga_partition_map_checksum (&apart) != 0)
 return grub_error (GRUB_ERR_BAD_PART_TABLE,
      "invalid Amiga partition map");

      part.start = (grub_swap_bytes32(apart.lowcyl)
      * grub_swap_bytes32(apart.heads)
      * grub_swap_bytes32(apart.block_per_track));
      part.len = ((grub_swap_bytes32(apart.highcyl)
     - grub_swap_bytes32(apart.lowcyl) + 1)
    * grub_swap_bytes32(apart.heads)
    * grub_swap_bytes32(apart.block_per_track));

      part.offset = next;
      part.number = partno;
      part.index = 0;
      part.partmap = &grub_amiga_partition_map;

      if (hook (disk, &part, hook_data))
 return grub_errno;

      next = grub_swap_bytes32(apart.next);
      partno++;
    }

  return 0;
}



