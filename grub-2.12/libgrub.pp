      char c;

      p.offset = (ptr >> 9) + 1;
      p.index = ptr & (0x200 - 1);

      err = grub_disk_read (disk, 1, ptr, sizeof (sig), sig);
      if (err)
 return err;
      if (grub_memcmp (sig, "part ", sizeof ("part ") - 1) != 0)
 break;
      ptr += sizeof (sig);
      do
 {
   err = grub_disk_read (disk, 1, ptr, 1, &c);
   if (err)
     return err;
   ptr++;
 }
      while (grub_isdigit (c) || grub_isalpha (c));
      if (c != ' ')
 break;
      p.start = 0;
      while (1)
 {
   err = grub_disk_read (disk, 1, ptr, 1, &c);
   if (err)
     return err;
   ptr++;
   if (!grub_isdigit (c))
     break;
   p.start = p.start * 10 + (c - '0');
 }
      if (c != ' ')
 break;
      p.len = 0;
      while (1)
 {
   err = grub_disk_read (disk, 1, ptr, 1, &c);
   if (err)
     return err;
   ptr++;
   if (!grub_isdigit (c))
     break;
   p.len = p.len * 10 + (c - '0');
 }
      if (c != '\n')
 break;
      p.len -= p.start;
      if (hook (disk, &p, hook_data))
 return grub_errno;
    }
  if (p.number == 0)
    return grub_error (GRUB_ERR_BAD_PART_TABLE, "not a plan partition table");

  return GRUB_ERR_NONE;
}


