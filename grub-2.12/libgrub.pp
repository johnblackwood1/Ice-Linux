   grub_free (sua);
   return err;
 }
      entry = (struct grub_iso9660_susp_entry *) sua;
      sua_size = ce_sua_size;
      ce_sua_size = 0;

      goto next_susp_area;
    }

  grub_free (sua);
  return 0;
}

static char *
grub_iso9660_convert_string (grub_uint8_t *us, int len)
{
  char *p;
