struct grub_apple_part
{


  grub_uint16_t magic;


  grub_uint16_t reserved;


  grub_uint32_t partmap_size;


  grub_uint32_t first_phys_block;


  grub_uint32_t blockcnt;


  char partname[32];


  char parttype[32];


  grub_uint32_t datablocks_first;


  grub_uint32_t datablocks_count;


  grub_uint32_t status;


  grub_uint32_t bootcode_pos;


  grub_uint32_t bootcode_size;


  grub_uint32_t bootcode_loadaddr;


  grub_uint32_t reserved2;


  grub_uint32_t bootcode_entrypoint;


  grub_uint32_t reserved3;


  grub_uint32_t bootcode_checksum;


  char processor[16];


  grub_uint16_t pad[187];
};

static struct grub_partition_map grub_apple_partition_map;


static grub_err_t
apple_partition_map_iterate (grub_disk_t disk,
        grub_partition_iterate_hook_t hook,
        void *hook_data)
{
  struct grub_partition part;
  struct grub_apple_header aheader;
  struct grub_apple_part apart;
  int partno = 0, partnum = 0;
  unsigned pos;

  part.partmap = &grub_apple_partition_map;

  if (grub_disk_read (disk, 0, 0, sizeof (aheader), &aheader))
    return grub_errno;

  if (grub_swap_bytes16(aheader.magic) != 0x4552)
    {
      grub_real_dprintf("config-util.h", 120, "partition", "bad magic (found 0x%x; wanted 0x%x)\n", grub_swap_bytes16(aheader.magic), 0x4552)


                              ;
      goto fail;
    }

  pos = grub_swap_bytes16(aheader.blocksize);

  do
    {
      part.offset = pos / 0x200;
      part.index = pos % 0x200;

      if (grub_disk_read (disk, part.offset, part.index,
     sizeof (struct grub_apple_part), &apart))
 return grub_errno;

      if (grub_swap_bytes16(apart.magic) != 0x504D)
 {
   grub_real_dprintf("config-util.h", 140, "partition", "partition %d: bad magic (found 0x%x; wanted 0x%x)\n", partno, grub_swap_bytes16(apart.magic), 0x504D)


                         ;
   break;
 }

      if (partnum == 0)
 partnum = grub_swap_bytes32(apart.partmap_size);

      part.start = ((grub_disk_addr_t) grub_swap_bytes32(apart.first_phys_block)
      * grub_swap_bytes16(aheader.blocksize))
 / 0x200;
      part.len = ((grub_disk_addr_t) grub_swap_bytes32(apart.blockcnt)
    * grub_swap_bytes16(aheader.blocksize))
 / 0x200;
      part.offset = pos;
      part.index = partno;
      part.number = partno;

      grub_real_dprintf("config-util.h", 160, "partition", "partition %d: name %s, type %s, start 0x%x, len 0x%x\n", partno, apart.partname, apart.parttype, grub_swap_bytes32(apart.first_phys_block), grub_swap_bytes32(apart.blockcnt))



                                        ;

      if (hook (disk, &part, hook_data))
 return grub_errno;

      pos += grub_swap_bytes16(aheader.blocksize);
      partno++;
    }
  while (partno < partnum);

  if (partno != 0)
    return 0;

 fail:
  return grub_error (GRUB_ERR_BAD_PART_TABLE,
       "Apple partition map not found");
}



static struct grub_partition_map grub_apple_partition_map =
  {
    .name = "apple",
    .iterate = apple_partition_map_iterate,
  };

@MARKER@part_apple@
{
  grub_partition_map_register (&grub_apple_partition_map);
}

GRUB_MOD_FINI(part_apple)
{
  grub_partition_map_unregister (&grub_apple_partition_map);
}
