  srcptr = grub_video_fb_get_video_ptr (src, offset_x, offset_y);
  dstptr = grub_video_fb_get_video_ptr (dst, x, y);

  for (j = 0; j < height; j++)
    {
      for (i = 0; i < width; i++)
        {
          grub_uint32_t color;
          unsigned int sr;
          unsigned int sg;
          unsigned int sb;
          unsigned int a;
          unsigned int dr;
          unsigned int dg;
          unsigned int db;

          color = *srcptr++;

          a = color >> 24;

          if (a == 0)
            {

              dstptr++;
              continue;
            }

          sr = (color >> 0) & 0xFF;
          sg = (color >> 8) & 0xFF;
          sb = (color >> 16) & 0xFF;

          if (a == 255)
            {

              dr = sr;
              dg = sg;
              db = sb;
            }
          else
            {

              color = *dstptr;

              dr = (color >> 16) & 0xFF;
              dr = alpha_dilute (dr, sr, a);
              dg = (color >> 8) & 0xFF;
              dg = alpha_dilute (dg, sg, a);
              db = (color >> 0) & 0xFF;
              db = alpha_dilute (db, sb, a);
            }

          color = (a << 24) | (dr << 16) | (dg << 8) | db;

          *dstptr++ = color;
        }

      ((srcptr) += (srcrowskip) / sizeof (*(srcptr)));
      ((dstptr) += (dstrowskip) / sizeof (*(dstptr)));
    }
