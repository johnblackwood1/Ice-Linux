 31 + 28 + 31 + 30 + 31 + 30 + 31,
 31 + 28 + 31 + 30 + 31 + 30 + 31 + 31,
 31 + 28 + 31 + 30 + 31 + 30 + 31 + 31 + 30,
 31 + 28 + 31 + 30 + 31 + 30 + 31 + 31 + 30 + 31,
