      else if (!data->rockridge
        && (voldesc.voldesc.type == 2)
        && (voldesc.escape[0] == 0x25) && (voldesc.escape[1] == 0x2f)
        &&
               ((voldesc.escape[2] == 0x40) ||
                (voldesc.escape[2] == 0x43) ||
                (voldesc.escape[2] == 0x45)))
        {
          copy_voldesc = 1;
          data->joliet = 1;
        }

      if (copy_voldesc)
