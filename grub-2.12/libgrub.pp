  struct grub_hfs_iterate_dir_node_found_ctx ctx =
  {
    .dir_be = grub_swap_bytes32(dir),
    .found = -1,
    .isleaf = 0,
    .next = 0,
    .hook = hook,
    .hook_arg = hook_arg
