}



static inline grub_size_t
grub_getend (const char *beg, const char *end)
{
  const char *ptr;
  for (ptr = end - 1; ptr >= beg; ptr--)
    if ((*ptr & 0xc0) != 0x80)
      break;
  if (ptr < beg)
    return 0;
  if ((*ptr & 0x80) == 0)
    return ptr + 1 - beg;
  if ((*ptr & 0xe0) == 0xc0
      && ptr + 2 <= end)
    return ptr + 2 - beg;
  if ((*ptr & 0xf0) == 0xe0
      && ptr + 3 <= end)
    return ptr + 3 - beg;
  if ((*ptr & 0xf8) == 0xf0
      && ptr + 4 <= end)
    return ptr + 4 - beg;

  return ptr - beg;
}


